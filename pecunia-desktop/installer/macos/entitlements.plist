<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- =================================================================== -->
    <!-- App Sandbox and Hardened Runtime -->
    <!-- =================================================================== -->

    <!-- Enable Hardened Runtime (required for notarization) -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Allow JIT compilation (for better Python performance) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required for some Python packages) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading dynamic libraries not signed by Apple -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow dyld environment variables (for debugging) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- =================================================================== -->
    <!-- Network Access -->
    <!-- =================================================================== -->

    <!-- Allow outgoing network connections (client) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow incoming network connections (server - for OAuth callbacks) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- =================================================================== -->
    <!-- File Access -->
    <!-- =================================================================== -->

    <!-- Read/write access to user-selected files (via file dialogs) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Read/write access to Downloads folder -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Read/write access to Documents folder -->
    <!-- Note: This requires NSDocumentsFolderUsageDescription in Info.plist -->

    <!-- =================================================================== -->
    <!-- Keychain Access -->
    <!-- =================================================================== -->

    <!-- Access keychain for storing credentials -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.pecunia.desktop</string>
    </array>

    <!-- =================================================================== -->
    <!-- Apple Events -->
    <!-- =================================================================== -->

    <!-- Allow sending Apple Events (for Finder integration, etc.) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- =================================================================== -->
    <!-- Additional Permissions -->
    <!-- =================================================================== -->

    <!-- Allow printing -->
    <key>com.apple.security.print</key>
    <true/>

    <!-- Allow use of personal information (contacts for payee suggestions) -->
    <key>com.apple.security.personal-information.addressbook</key>
    <false/>

    <!-- Allow calendar access (for bill reminders) -->
    <key>com.apple.security.personal-information.calendars</key>
    <false/>

</dict>
</plist>
