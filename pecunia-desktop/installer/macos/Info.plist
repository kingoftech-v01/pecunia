<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- =================================================================== -->
    <!-- Application Identity -->
    <!-- =================================================================== -->

    <key>CFBundleName</key>
    <string>Pecunia</string>

    <key>CFBundleDisplayName</key>
    <string>Pecunia Desktop</string>

    <key>CFBundleIdentifier</key>
    <string>com.pecunia.desktop</string>

    <key>CFBundleExecutable</key>
    <string>Pecunia</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <!-- =================================================================== -->
    <!-- Version Information -->
    <!-- =================================================================== -->

    <key>CFBundleVersion</key>
    <string>1.0.0</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2024 Pecunia Inc. All rights reserved.</string>

    <!-- =================================================================== -->
    <!-- System Requirements -->
    <!-- =================================================================== -->

    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>

    <key>LSArchitecturePriority</key>
    <array>
        <string>x86_64</string>
        <string>arm64</string>
    </array>

    <!-- =================================================================== -->
    <!-- Application Category -->
    <!-- =================================================================== -->

    <key>LSApplicationCategoryType</key>
    <string>public.app-category.finance</string>

    <!-- =================================================================== -->
    <!-- Display Settings -->
    <!-- =================================================================== -->

    <key>CFBundleIconFile</key>
    <string>app_icon.icns</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <key>NSRequiresAquaSystemAppearance</key>
    <false/>

    <!-- =================================================================== -->
    <!-- Application Behavior -->
    <!-- =================================================================== -->

    <key>LSUIElement</key>
    <false/>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <key>LSBackgroundOnly</key>
    <false/>

    <!-- =================================================================== -->
    <!-- Privacy Permissions -->
    <!-- =================================================================== -->

    <!-- Network Access -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
            <key>pecunia.com</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionMinimumTLSVersion</key>
                <string>TLSv1.2</string>
            </dict>
        </dict>
    </dict>

    <!-- File Access -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Pecunia needs access to your Documents folder to export financial reports and data.</string>

    <key>NSDownloadsFolderUsageDescription</key>
    <string>Pecunia needs access to your Downloads folder to export financial reports.</string>

    <key>NSDesktopFolderUsageDescription</key>
    <string>Pecunia needs access to your Desktop to save exported files.</string>

    <!-- Keychain Access -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Pecunia uses Apple Events for system integration.</string>

    <!-- =================================================================== -->
    <!-- URL Schemes -->
    <!-- =================================================================== -->

    <key>CFBundleURLTypes</key>
    <array>
        <!-- Custom URL Scheme (pecunia://) -->
        <dict>
            <key>CFBundleURLName</key>
            <string>com.pecunia.desktop</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>pecunia</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
        </dict>
        <!-- OAuth Callback -->
        <dict>
            <key>CFBundleURLName</key>
            <string>com.pecunia.desktop.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>pecunia-oauth</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
        </dict>
    </array>

    <!-- =================================================================== -->
    <!-- Document Types -->
    <!-- =================================================================== -->

    <key>CFBundleDocumentTypes</key>
    <array>
        <!-- Pecunia Data File -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Pecunia Data File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>pecunia</string>
                <string>fad</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>document.icns</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.pecunia.datafile</string>
            </array>
        </dict>
        <!-- CSV Import -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>CSV File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>csv</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>
        <!-- OFX Import -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>OFX Financial File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>ofx</string>
                <string>qfx</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>
        <!-- QIF Import -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>QIF Financial File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>qif</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>
    </array>

    <!-- =================================================================== -->
    <!-- Exported Type Declarations -->
    <!-- =================================================================== -->

    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.pecunia.datafile</string>
            <key>UTTypeDescription</key>
            <string>Pecunia Data File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>pecunia</string>
                    <string>fad</string>
                </array>
                <key>public.mime-type</key>
                <string>application/x-pecunia</string>
            </dict>
        </dict>
    </array>

    <!-- =================================================================== -->
    <!-- Imported Type Declarations -->
    <!-- =================================================================== -->

    <key>UTImportedTypeDeclarations</key>
    <array>
        <!-- OFX Type -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.intuit.ofx</string>
            <key>UTTypeDescription</key>
            <string>Open Financial Exchange File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.xml</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ofx</string>
                    <string>qfx</string>
                </array>
            </dict>
        </dict>
        <!-- QIF Type -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.intuit.qif</string>
            <key>UTTypeDescription</key>
            <string>Quicken Interchange Format File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>qif</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- =================================================================== -->
    <!-- Services -->
    <!-- =================================================================== -->

    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Add to Pecunia</string>
            </dict>
            <key>NSMessage</key>
            <string>addTransaction</string>
            <key>NSPortName</key>
            <string>Pecunia</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.plain-text</string>
            </array>
        </dict>
    </array>

    <!-- =================================================================== -->
    <!-- Sparkle Auto-Update (if using Sparkle framework) -->
    <!-- =================================================================== -->

    <key>SUFeedURL</key>
    <string>https://pecunia.com/updates/appcast.xml</string>

    <key>SUPublicEDKey</key>
    <string></string>

    <key>SUEnableAutomaticChecks</key>
    <true/>

    <key>SUAllowsAutomaticUpdates</key>
    <true/>

    <!-- =================================================================== -->
    <!-- Additional Metadata -->
    <!-- =================================================================== -->

    <key>NSContactsUsageDescription</key>
    <string>Pecunia can optionally import contacts for payee suggestions.</string>

    <key>NSCalendarsUsageDescription</key>
    <string>Pecunia can optionally add bill reminders to your calendar.</string>

    <key>NSRemindersUsageDescription</key>
    <string>Pecunia can optionally create reminders for upcoming bills.</string>

</dict>
</plist>
