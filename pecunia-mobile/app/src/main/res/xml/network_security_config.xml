<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production configuration: only allow HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development domains - cleartext only allowed in debug builds via debug-overrides -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Production domains with certificate pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.pecunia.com</domain>
        <domain includeSubdomains="true">auth.pecunia.com</domain>
        <domain includeSubdomains="true">cdn.pecunia.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <!-- TODO: Replace placeholder pins with real certificate pins before production release -->
        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">YOUR_PRIMARY_CERTIFICATE_PIN_HERE</pin>
            <pin digest="SHA-256">YOUR_BACKUP_CERTIFICATE_PIN_HERE</pin>
        </pin-set>
    </domain-config>
</network-security-config>
